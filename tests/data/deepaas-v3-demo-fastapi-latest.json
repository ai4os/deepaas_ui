  "/v2/models/ai4os_demo_app/predict/": {
   "post": {
    "tags": [
     "v2",
     "predict",
     "models",
     "predict"
    ],
    "summary": "Predict",
    "description": "Make a prediction given the input data.",
    "operationId": "predict_v2_models_ai4os_demo_app_predict__post",
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_predict_v2_models_ai4os_demo_app_predict__post"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ModelPredictionResponse"
        }
       },
       "application/zip": {},
       "image/*": {}
      }
     },
     "406": {
      "description": "Requested media type not supported"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "demo_str",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "some-string"
      },
      "description": "test string"
     },
     {
      "name": "demo_str_choice",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "choice2",
       "enum": [
        "choice1",
        "choice2"
       ]
      },
      "description": "test multi-choice with strings"
     },
     {
      "name": "demo_password",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "some-string",
       "format": "password"
      }
     },
     {
      "name": "demo_int",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 1
      },
      "description": "test integer"
     },
     {
      "name": "demo_int_range",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 50,
       "minimum": 1,
       "maximum": 100
      },
      "description": "test integer is inside a min-max range"
     },
     {
      "name": "demo_float",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "default": 0.1
      },
      "description": "test float"
     },
     {
      "name": "demo_bool",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": true
      },
      "description": "test boolean"
     },
     {
      "name": "demo_dict",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "{'a': 0, 'b': 1}"
      },
      "description": "test dictionary"
     },
     {
      "name": "demo_list_of_floats",
      "in": "query",
      "required": false,
      "schema": {
       "items": {
        "type": "number"
       },
       "type": "array",
       "default": [
        0.1,
        0.2,
        0.3
       ]
      },
      "description": "test list of floats"
     }
    ]
   }
  },
