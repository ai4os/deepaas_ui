{"info": {"description": "<img src='https://marketplace.deep-hybrid-datacloud.eu/images/logo-deep.png' width=200 alt='' />\n\nThis is a REST API that is focused on providing access to machine learning models. By using the DEEPaaS API users can easily run a REST API in front of their model, thus accessing its functionality via HTTP calls. \n\nCurrently you are browsing the [Swagger UI](https://swagger.io/tools/swagger-ui/) for this API, a tool that allows you to visualize and interact with the API and the underlying model.\n- [Project website](https://deep-hybrid.datacloud.eu).\n- [Project documentation](https://docs.deep-hybrid.datacloud.eu).\n- [Model marketplace](https://marketplace.deep-hybrid.datacloud.eu).\n", "title": "DEEP as a Service API endpoint", "version": "2.6.0"}, "externalDocs": {"description": "API documentation", "url": "https://deepaas.readthedocs.org/"}, "paths": {"/v2/": {"get": {"responses": {"400": {"schema": {"$ref": "#/definitions/Failure"}, "description": ""}, "200": {"schema": {"$ref": "#/definitions/Version"}, "description": ""}}, "parameters": [], "tags": ["versions"], "summary": "Get V2 API version information", "produces": ["application/json"]}}, "/v2/debug/": {"get": {"responses": {"200": {"description": "Debug information if debug endpoint is enabled"}, "204": {"description": "Debug endpoint not enabled"}}, "parameters": [], "tags": ["debug"], "summary": "Return debug information if enabled by API.", "description": "Return debug information if enabled by API.", "produces": ["text/plain"]}}, "/v2/models/": {"get": {"responses": {"200": {"schema": {"$ref": "#/definitions/ModelMeta"}, "description": ""}}, "parameters": [], "tags": ["models"], "summary": "Return loaded models and its information", "description": "DEEPaaS can load several models and server them on the same endpoint, making a call to the root of the models namespace will return the loaded models, as long as their basic metadata.", "produces": ["application/json"]}}, "/v2/models/ai4os_demo_app/": {"get": {"responses": {"200": {"schema": {"$ref": "#/definitions/ModelMeta"}, "description": ""}}, "parameters": [], "tags": ["models"], "summary": "Return model's metadata", "produces": ["application/json"]}}, "/v2/models/ai4os_demo_app/train/": {"post": {"responses": {}, "parameters": [{"in": "query", "name": "epoch_num", "required": false, "type": "integer", "format": "int32", "default": 10, "description": "Total number of training epochs"}], "tags": ["models"], "summary": "Retrain model with available data", "produces": ["application/json"]}, "get": {"responses": {"200": {"schema": {"$ref": "#/definitions/TrainingList"}, "description": ""}}, "parameters": [], "tags": ["models"], "summary": "Get a list of trainings (running or completed)", "produces": ["application/json"]}}, "/v2/models/ai4os_demo_app/train/{uuid}": {"get": {"responses": {"200": {"schema": {"$ref": "#/definitions/Training"}, "description": ""}}, "parameters": [{"in": "path", "name": "uuid", "required": true, "type": "string"}], "tags": ["models"], "summary": "Get status of a training", "produces": ["application/json"]}, "delete": {"responses": {}, "parameters": [{"in": "path", "name": "uuid", "required": true, "type": "string"}], "tags": ["models"], "summary": "Cancel a running training", "produces": ["application/json"]}}, "/v2/models/ai4os_demo_app/predict/": {"post": {"responses": {"400": {"schema": {"$ref": "#/definitions/Failure"}, "description": ""}, "200": {"schema": {"$ref": "#/definitions/ModelPredictionResponse"}, "description": ""}}, "parameters": [{"in": "query", "name": "demo_str", "required": false, "type": "string", "default": "some-string", "description": "test string"}, {"in": "query", "name": "demo_str_choice", "required": false, "type": "string", "default": "choice2", "enum": ["choice1", "choice2"], "description": "test multi-choice with strings"}, {"in": "query", "name": "demo_password", "required": false, "type": "string", "default": "some-string", "min